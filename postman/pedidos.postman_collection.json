{
  "info": {
    "name": "Pedidos - 12 casos",
    "description": "Ejecutar completa, una iteración y en orden. PREP y LIMPIEZA no son casos. TC09 y TC12 requieren varias solicitudes. Los esquemas del cuerpo se extraen de openapi.json; no es una validación integral de OpenAPI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "PREP Preparar datos",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/test/reset",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test",
            "reset"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "const id = \"PREP\";",
              "pm.test(id + ' | estado 200', () => pm.response.to.have.status(200));",
              "pm.test(id + ' | Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test(id + ' | esquema Preparacion', () => pm.response.to.have.jsonSchema({\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"tokenA\", \"tokenB\", \"pedidosInicialesA\"], \"properties\": {\"tokenA\": {\"type\": \"string\", \"minLength\": 48}, \"tokenB\": {\"type\": \"string\", \"minLength\": 48}, \"pedidosInicialesA\": {\"type\": \"integer\", \"enum\": [3]}}}));",
              "pm.environment.set('tokenA', data.tokenA);",
              "pm.environment.set('tokenB', data.tokenB);",
              "['pedidoId','pagina1','antes'].forEach(k => pm.environment.unset(k));"
            ]
          }
        }
      ]
    },
    {
      "name": "TC01 Crear pedido válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"productoId\": \"cuaderno\", \"cantidad\": 2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "const id = \"TC01\";",
              "pm.test(id + ' | estado 201', () => pm.response.to.have.status(201));",
              "pm.test(id + ' | Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test(id + ' | esquema Pedido', () => pm.response.to.have.jsonSchema({\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"id\", \"usuarioId\", \"productoId\", \"cantidad\", \"total\", \"estado\", \"cancelaciones\"], \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$\"}, \"usuarioId\": {\"type\": \"string\", \"enum\": [\"usuario-a\", \"usuario-b\"]}, \"productoId\": {\"type\": \"string\", \"enum\": [\"cuaderno\"]}, \"cantidad\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 10}, \"total\": {\"type\": \"number\", \"minimum\": 25, \"maximum\": 250}, \"estado\": {\"type\": \"string\", \"enum\": [\"pendiente\", \"cancelado\"]}, \"cancelaciones\": {\"type\": \"integer\", \"minimum\": 0, \"maximum\": 1}}}));",
              "pm.test(id + ' | reglas de creación', () => { pm.expect(data.usuarioId).to.eql('usuario-a'); pm.expect(data.cantidad).to.eql(2); pm.expect(data.productoId).to.eql('cuaderno'); pm.expect(data.total).to.eql(50); pm.expect(data.estado).to.eql('pendiente'); pm.expect(data.cancelaciones).to.eql(0); });",
              "if (pm.response.code === 201) pm.environment.set('pedidoId', data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "TC02 Consultar pedido creado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
