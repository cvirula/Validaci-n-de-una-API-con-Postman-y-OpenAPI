      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "const id = \"TC09\";",
              "pm.test(id + ' | estado 200', () => pm.response.to.have.status(200));",
              "pm.test(id + ' | Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test(id + ' | esquema PaginaPedidos', () => pm.response.to.have.jsonSchema({\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"items\", \"page\", \"limit\", \"total\"], \"properties\": {\"items\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"id\", \"usuarioId\", \"productoId\", \"cantidad\", \"total\", \"estado\", \"cancelaciones\"], \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$\"}, \"usuarioId\": {\"type\": \"string\", \"enum\": [\"usuario-a\", \"usuario-b\"]}, \"productoId\": {\"type\": \"string\", \"enum\": [\"cuaderno\"]}, \"cantidad\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 10}, \"total\": {\"type\": \"number\", \"minimum\": 25, \"maximum\": 250}, \"estado\": {\"type\": \"string\", \"enum\": [\"pendiente\", \"cancelado\"]}, \"cancelaciones\": {\"type\": \"integer\", \"minimum\": 0, \"maximum\": 1}}}}, \"page\": {\"type\": \"integer\", \"minimum\": 1}, \"limit\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 10}, \"total\": {\"type\": \"integer\", \"minimum\": 0}}}));",
              "pm.test(id + ' | página y efectos de creación', () => { pm.expect(data.page).to.eql(1); pm.expect(data.limit).to.eql(2); pm.expect(data.total).to.eql(4); pm.expect(data.items).to.have.lengthOf(2); data.items.forEach(p => pm.expect(p.usuarioId).to.eql('usuario-a')); });",
              "pm.environment.set('pagina1', JSON.stringify(data.items.map(p => p.id))); pm.environment.set('antes', data.total);"
            ]
          }
        }
      ]
    },
