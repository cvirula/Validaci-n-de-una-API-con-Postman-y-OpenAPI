            "pedidos",
            "{{pedidoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "const id = \"TC02\";",
              "pm.test(id + ' | estado 200', () => pm.response.to.have.status(200));",
              "pm.test(id + ' | Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test(id + ' | esquema Pedido', () => pm.response.to.have.jsonSchema({\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"id\", \"usuarioId\", \"productoId\", \"cantidad\", \"total\", \"estado\", \"cancelaciones\"], \"properties\": {\"id\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$\"}, \"usuarioId\": {\"type\": \"string\", \"enum\": [\"usuario-a\", \"usuario-b\"]}, \"productoId\": {\"type\": \"string\", \"enum\": [\"cuaderno\"]}, \"cantidad\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 10}, \"total\": {\"type\": \"number\", \"minimum\": 25, \"maximum\": 250}, \"estado\": {\"type\": \"string\", \"enum\": [\"pendiente\", \"cancelado\"]}, \"cancelaciones\": {\"type\": \"integer\", \"minimum\": 0, \"maximum\": 1}}}));",
              "pm.test(id + ' | persistencia', () => { pm.expect(data.id).to.eql(pm.environment.get('pedidoId')); pm.expect(data.cantidad).to.eql(2); pm.expect(Number(data.total)).to.eql(50); pm.expect(data.estado).to.eql('pendiente'); pm.expect(data.cancelaciones).to.eql(0); });"
            ]
          }
        }
      ]
    },
