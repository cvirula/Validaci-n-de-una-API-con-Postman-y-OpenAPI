{
  "openapi": "3.1.0",
  "info": {
    "title": "API de pedidos",
    "version": "1.0.0",
    "description": "Ejercicio local. Precio de cuaderno: Q25. Cantidad de 1 a 10. Usuarios ficticios y almacenamiento en memoria."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token temporal generado por POST /test/reset. No hay credenciales persistentes."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_BODY",
                  "INVALID_PRODUCT",
                  "INVALID_PAGINATION",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "UNSUPPORTED_MEDIA_TYPE"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "Pedido": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "usuarioId",
          "productoId",
          "cantidad",
          "total",
          "estado",
          "cancelaciones"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "usuarioId": {
            "type": "string",
            "enum": [
              "usuario-a",
              "usuario-b"
            ]
          },
          "productoId": {
            "type": "string",
            "enum": [
              "cuaderno"
            ]
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "total": {
            "type": "number",
            "minimum": 25,
            "maximum": 250
          },
          "estado": {
            "type": "string",
            "enum": [
              "pendiente",
              "cancelado"
            ]
          },
          "cancelaciones": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "CrearPedido": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productoId",
          "cantidad"
        ],
        "properties": {
          "productoId": {
            "type": "string",
            "enum": [
              "cuaderno"
            ]
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      },
      "CancelarPedido": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "estado"
        ],
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "cancelado"
            ]
          }
        }
      },
      "PaginaPedidos": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "limit",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pedido"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Producto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre",
          "precio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "cuaderno"
            ]
          },
          "nombre": {
            "type": "string",
            "enum": [
              "Cuaderno"
            ]
          },
          "precio": {
            "type": "number",
            "enum": [
              25
            ]
          }
        }
      },
      "PaginaProductos": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "limit",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Producto"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Preparacion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tokenA",
          "tokenB",
          "pedidosInicialesA"
        ],
        "properties": {
          "tokenA": {
            "type": "string",
            "minLength": 48
          },
          "tokenB": {
            "type": "string",
            "minLength": 48
          },
          "pedidosInicialesA": {
            "type": "integer",
            "enum": [
              3
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/productos": {
      "get": {
        "operationId": "listarProductos",
        "summary": "Consultar catálogo paginado",
        "security": [],
        "responses": {
          "200": {
            "description": "Catálogo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaProductos"
                }
              }
            }
          },
          "400": {
            "description": "Paginación inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 2
            }
          }
        ]
      }
    },
    "/test/reset": {
      "post": {
        "operationId": "prepararDatos",
        "summary": "Reiniciar datos y crear sesiones ficticias locales",
        "security": [],
        "responses": {
          "200": {
            "description": "Sesiones nuevas y tres pedidos de A, uno de B",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preparacion"
                }
              }
            }
          }
        },
        "description": "Herramienta del ejercicio local, accesible solo en la interfaz loopback. Borra pedidos previos e invalida todas las sesiones; no debe desplegarse públicamente."
      }
    },
    "/pedidos": {
      "get": {
        "operationId": "listarPedidos",
        "summary": "Listar únicamente pedidos del usuario",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Página de pedidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaPedidos"
                }
              }
            }
          },
          "400": {
            "description": "Paginación inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente o inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 2
            }
          }
        ]
      },
      "post": {
        "operationId": "crearPedido",
        "summary": "Crear pedido del usuario autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Pedido creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pedido"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos, faltantes o producto inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente o inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Tipo de contenido inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearPedido"
              }
            }
          }
        }
      }
    },
    "/pedidos/{id}": {
      "get": {
        "operationId": "consultarPedido",
        "summary": "Consultar un pedido propio",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pedido"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente o inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Pedido de otro usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Pedido inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID devuelto al crear o listar un pedido. Un ID ausente devuelve 404."
          }
        ]
      }
    },
    "/pedidos/{id}/cancelacion": {
      "put": {
        "operationId": "cancelarPedido",
        "summary": "Cancelar de forma idempotente",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pedido cancelado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pedido"
                }
              }
            }
          },
          "400": {
            "description": "Cuerpo inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente o inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Pedido ajeno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Pedido inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Tipo de contenido inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelarPedido"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID devuelto al crear o listar un pedido. Un ID ausente devuelve 404."
          }
        ],
        "description": "PUT establece estado=cancelado. Solo la primera transición incrementa cancelaciones; repetir no crea pedidos ni incrementa el contador. El estado final se consulta con GET. POST /pedidos no es idempotente."
      }
    }
  }
}
